# Netra Runtime is the sole LLM provider used by the deployed API.
NAYANA_RAG_PROVIDER=netra
NAYANA_RAG_NETRA_MODEL=deepseek/deepseek-v4-flash-0731
# Required only when rebuilding the server-owned NEI evidence corpus.
FIRECRAWL_API_KEY=
NAYANA_RAG_VERSION=
