{
  "name": "nayana-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=nayana-web",
    "check:structure": "bash tools/repository/check-structure.sh",
    "check:css": "npm run check:css --workspace=nayana-web",
    "lint": "npm run lint --workspace=nayana-web",
    "build": "npm run build --workspace=nayana-web",
    "validate": "npm run check:structure && npm run check:css && npm run lint && npm run build"
  }
}
